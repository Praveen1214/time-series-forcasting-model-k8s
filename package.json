{
    "name": "informer-k8s-controller",
    "version": "1.0.0",
    "description": "Smart Resource Allocation Controller — connects ML Prediction API to K8s Scaling Executor",
    "main": "controller/controller.js",
    "scripts": {
        "start": "node controller/controller.js",
        "dev": "node controller/controller.js --dry-run --interval 0 --steps 20",
        "peak": "node controller/controller.js --dry-run --validate --interval 0 --steps 60 --start-offset 770",
        "validate": "node controller/controller.js --dry-run --validate --interval 0 --steps 80 --start-offset 770"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "kubernetes",
        "autoscaling",
        "bilstm",
        "ml",
        "controller"
    ],
    "license": "MIT"
}